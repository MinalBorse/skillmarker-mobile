# Copy to .env. Never commit .env.
# The job data (Bundesagentur für Arbeit) needs no key.

# LLM for extraction, CV reading and "Ask the market" (optional: without it, rules are used)
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# USD per million tokens, used when the API doesn't report costs itself
LLM_PRICE_INPUT_PER_M=0.15
LLM_PRICE_OUTPUT_PER_M=0.60

# Embeddings: auto (local multilingual model, falls back to offline hashing), fastembed, or hash
EMBED_BACKEND=auto

# Optional: Adzuna job search API (free developer key at developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
